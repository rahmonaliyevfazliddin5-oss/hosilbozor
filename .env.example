# ==========================================
# HosilBozor Environment Variables (Template)
# ==========================================

# App & Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME=HosilBozor
API_V1_STR=/api/v1
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long-uzbekistan-agri
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# Database (PostgreSQL with PostGIS)
# For local Docker Compose:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/hosilbozor_db
# For SQLite test mode fallback:
# DATABASE_URL=sqlite:///./hosilbozor_dev.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/bot/webhook
TELEGRAM_BOT_USERNAME=HosilBozorBot

# SMS Provider (Eskiz / PlayMobile / Console Mock)
SMS_PROVIDER=mock
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# Escrow Payment Providers (Mock / Payme / Click / Uzum)
ESCROW_PROVIDER=mock
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
